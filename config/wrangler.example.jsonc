// Copy this file to wrangler.jsonc in the project root.
// Set secrets with:
//   npx wrangler secret put ADMIN_PIN
//   npx wrangler secret put ADMIN_SESSION_SECRET
// Optional separate encryption secret for per-user Drive keys:
//   npx wrangler secret put DRIVE_VAULT_KEY
// ADMIN_SESSION_SECRET should be a random value of at least 32 bytes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vbook-webdav",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-20",
  "kv_namespaces": [
    {
      "binding": "USER_KV",
      "id": "YOUR_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_R2",
      "bucket_name": "YOUR_BUCKET_NAME"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_STORAGE",
        "class_name": "UserStorage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "user-storage-v1",
      "new_sqlite_classes": [
        "UserStorage"
      ]
    }
  ]
}
